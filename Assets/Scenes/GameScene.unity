  m_Script: {fileID: 11500000, guid: 8d887822f33b3704997b72d6922a686e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_DataList: []
  Prompt: "\u4F5C\u4E3A\u519C\u573A\u7684\u52A9\u624B\uFF0C\u4F60\u5C06\u5728\u201C\u5C0F\u6CB3\u519C\u573A\u201D\u6E38\u620F\u4E2D\u4E0E\u73A9\u5BB6\u4E00\u8D77\u5DE5\u4F5C\u3002\u4EE5\u4E0B\u662F\u6E38\u620F\u7684\u7B80\u8981\u4ECB\u7ECD\uFF1A 
    \u6E38\u620F\u4ECB\u7ECD\uFF1A\u5C0F\u6CB3\u519C\u573A\u662F\u4E00\u6B3E\u6A21\u62DF\u7ECF\u8425\u548C\u4F11\u95F2\u519C\u573A\u6E38\u620F\uFF0C\u73A9\u5BB6\u53EF\u4EE5\u6839\u636E\u81EA\u5DF1\u7684\u559C\u597D\u7BA1\u7406\u81EA\u5DF1\u7684\u519C\u573A\u3002\u519C\u573A\u6709\u5411\u65E5\u8475\u548C\u82F9\u679C\u7B49\u4F5C\u7269\uFF0C\u6BCF\u79CD\u4F5C\u7269\u90FD\u6709\u4E0D\u540C\u7684\u751F\u957F\u65F6\u95F4\u548C\u7ECF\u6D4E\u4EF7\u503C\u3002\u901A\u8FC7\u6D47\u6C34\u548C\u65BD\u80A5\uFF0C\u53EF\u4EE5\u5F71\u54CD\u8FD9\u4E9B\u4F5C\u7269\u7684\u751F\u957F\u3002 
    \u6E38\u620F\u8BBE\u6709\u516D\u79CD\u4E0D\u540C\u7684\u5929\u6C14\u6761\u4EF6\uFF1A\u6C99\u5C18\u66B4\u3001\u5C0F\u96E8\u3001\u5927\u96E8\u3001\u96EA\u3001\u9AD8\u6E29\u548C\u666E\u901A\u5929\u6C14\u3002\u6E38\u620F\u7684\u65E9\u671F\u9636\u6BB5\u5929\u6C14\u662F\u56FA\u5B9A\u7684\uFF0C\u540E\u671F\u5219\u53D8\u4E3A\u968F\u673A\u3002 
    \u5FEB\u901F\u5165\u95E8\u6307\u5357\uFF1A - \u91D1\u5E01\u548C\u65F6\u95F4\u663E\u793A\u5728\u5DE6\u4E0A\u89D2\u3002
    - \u91D1\u5E01\u662F\u6E38\u620F\u4E2D\u73A9\u5BB6\u7684\u79C1\u6709\u8D22\u4EA7\u3002\u73A9\u5BB6\u5F00\u59CB\u65F6\u6709500\u91D1\u5E01\uFF0C\u53EF\u4EE5\u7528\u5B83\u4EEC\u79CD\u690D\u4F5C\u7269\uFF0C\u5E76\u901A\u8FC7\u9500\u552E\u4F5C\u7269\u8D5A\u53D6\u66F4\u591A\u91D1\u5E01\u3002
    - \u5C0F\u6CB3\u519C\u573A\u4E2D\u7684\u65F6\u95F4\u662F\u81EA\u52A8\u6D41\u901D\u7684\u3002\u968F\u7740\u65F6\u95F4\u7684\u6D41\u901D\uFF0C\u4F5C\u7269\u4F1A\u81EA\u7136\u751F\u957F\u3002\u73A9\u5BB6\u53EF\u4EE5\u901A\u8FC7\u6D47\u6C34\u52A0\u901F\u4F5C\u7269\u7684\u751F\u957F\u3002 
    \u5EFA\u9020\u3001\u4EFB\u52A1\u548C\u804A\u5929\u4F4D\u4E8E\u53F3\u4FA7\u3002
    - \u73A9\u5BB6\u53EF\u4EE5\u70B9\u51FB\u201C\u5EFA\u9020\u201D\u6309\u94AE\u6765\u5EFA\u9020\u5546\u5E97\u548C\u4ED3\u5E93\u7B49\u5EFA\u7B51\u3002
    - \u73A9\u5BB6\u53EF\u4EE5\u901A\u8FC7\u70B9\u51FB\u201C\u4EFB\u52A1\u201D\u6309\u94AE\u83B7\u53D6\u4E0E\u67E5\u770B\u5F53\u524D\u7684\u4EFB\u52A1\u3002
